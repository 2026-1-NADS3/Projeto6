<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <!--  Banner azul superior  -->
        <View android:id="@+id/viewBannerCadastro" android:layout_width="0dp" android:layout_height="200dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <!--  Logo no banner  -->
        <ImageView android:id="@+id/imgLogoCadastro" android:layout_width="120dp" android:layout_height="45dp" android:scaleType="fitCenter" android:src="@drawable/logo_maya" android:contentDescription="Logo Maya" app:layout_constraintTop_toTopOf="@id/viewBannerCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVerticalBias="0.3" app:layout_constraintBottom_toBottomOf="@id/viewBannerCadastro"/>
        <!--  Título CRIAR CONTA  -->
        <TextView android:id="@+id/txtTituloCadastro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRIAR CONTA" android:textSize="18sp" android:textColor="@color/white" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/imgLogoCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="@id/viewBannerCadastro" app:layout_constraintVerticalBias="0.7"/>
        <!--  CardView do formulário  -->
        <androidx.cardview.widget.CardView android:id="@+id/cardCadastro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="-24dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="6dp" app:layout_constraintTop_toBottomOf="@id/viewBannerCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                <!--  Abas LOGIN / CRIAR CONTA  -->
                <LinearLayout android:id="@+id/layoutAbasCadastro" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                    <TextView android:id="@+id/tabLoginNoCadastro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOGIN" android:textSize="13sp" android:textColor="@color/text_muted" android:layout_marginEnd="12dp"/>
                    <TextView android:id="@+id/tabCriarContaAtiva" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRIAR CONTA" android:textSize="13sp" android:textColor="@color/white" android:background="@color/maya_cyan" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                </LinearLayout>
                <!--  Campo Nome Completo  -->
                <EditText android:id="@+id/editNomeCadastro" android:layout_width="0dp" android:layout_height="48dp" android:hint="Nome Completo" android:inputType="textPersonName" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/layoutAbasCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
                <!--  Campo Data de Nascimento  -->
                <EditText android:id="@+id/editNascimentoCadastro" android:layout_width="0dp" android:layout_height="48dp" android:hint="Data de Nascimento" android:inputType="date" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/editNomeCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
                <!--  Campo CPF  -->
                <EditText android:id="@+id/editCpfCadastro" android:layout_width="0dp" android:layout_height="48dp" android:hint="CPF" android:inputType="number" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/editNascimentoCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
                <!--  Campo E-mail  -->
                <EditText android:id="@+id/editEmailCadastro" android:layout_width="0dp" android:layout_height="48dp" android:hint="E-mail" android:inputType="textEmailAddress" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/editCpfCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
                <!--  Campo Senha  -->
                <EditText android:id="@+id/editSenhaCadastro" android:layout_width="0dp" android:layout_height="48dp" android:hint="Senha" android:inputType="textPassword" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/editEmailCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="16dp"/>
                <!--  Botão CADASTRAR  -->
                <Button android:id="@+id/btnCadastrar" android:layout_width="0dp" android:layout_height="48dp" android:text="CADASTRAR" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="15sp" android:letterSpacing="0.08" app:layout_constraintTop_toBottomOf="@id/editSenhaCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="8dp"/>
                <!--  Botão Voltar Login  -->
                <Button android:id="@+id/btnVoltarLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Já tem conta? Faça Login" android:textColor="@color/maya_cyan" android:background="@android:color/transparent" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/btnCadastrar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <!--  Logos sociais embaixo do card  -->
        <LinearLayout android:id="@+id/layoutSociaisCadastro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" app:layout_constraintTop_toBottomOf="@id/cardCadastro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cadastre com" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginEnd="10dp"/>
            <ImageButton android:id="@+id/btnCadastroApple" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@drawable/bg_social_button" android:scaleType="centerInside" android:contentDescription="Cadastro com Apple" android:layout_marginEnd="10dp"/>
            <ImageButton android:id="@+id/btnCadastroGoogle" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_search" android:background="@drawable/bg_social_button" android:scaleType="centerInside" android:contentDescription="Cadastro com Google"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>