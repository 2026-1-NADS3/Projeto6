<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray">
    <!--  Topo azul de 180dp  -->
    <View android:id="@+id/viewTopoPerfil" android:layout_width="0dp" android:layout_height="180dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Logo no topo  -->
    <ImageView android:id="@+id/imgLogoPerfil" android:layout_width="100dp" android:layout_height="36dp" android:scaleType="fitCenter" android:src="@drawable/logo_maya" android:contentDescription="Logo Maya" android:layout_marginTop="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Foto de perfil — circular, sobrepondo a linha divisória  -->
    <ImageView android:id="@+id/imgFotoPerfil" android:layout_width="80dp" android:layout_height="80dp" android:src="@android:drawable/ic_menu_myplaces" android:scaleType="centerCrop" android:contentDescription="Foto de perfil do usuário" android:background="@drawable/bg_avatar_circular" app:layout_constraintTop_toBottomOf="@id/viewTopoPerfil" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="-40dp"/>
    <!--  ScrollView com os dados  -->
    <ScrollView android:id="@+id/scrollPerfil" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="72dp" app:layout_constraintTop_toBottomOf="@id/imgFotoPerfil" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp">
            <!--  Nome do usuário  -->
            <TextView android:id="@+id/txtNomeUsuario" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Nome do Paciente" android:textSize="18sp" android:textColor="@color/text_dark" android:textStyle="bold" android:gravity="center" android:layout_marginTop="10dp" android:layout_marginBottom="4dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <!--  CardView com dados cadastrais  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardDadosPerfil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtNomeUsuario" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <!--  E-mail  -->
                    <ImageView android:id="@+id/icEmail" android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_dialog_email" android:contentDescription="E-mail" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtEmailPerfil" android:layout_width="0dp" android:layout_height="wrap_content" android:text="paciente@email.com" android:textSize="13sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/icEmail" app:layout_constraintBottom_toBottomOf="@id/icEmail" app:layout_constraintStart_toEndOf="@id/icEmail" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Divisor  -->
                    <View android:id="@+id/dividerEmail" android:layout_width="0dp" android:layout_height="0.5dp" android:background="@color/divider_gray" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" app:layout_constraintTop_toBottomOf="@id/icEmail" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Plano  -->
                    <ImageView android:id="@+id/icPlano" android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_myplaces" android:contentDescription="Plano" app:layout_constraintTop_toBottomOf="@id/dividerEmail" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtPlanoPerfil" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Plano: Reabilitação Clínica" android:textSize="13sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/icPlano" app:layout_constraintBottom_toBottomOf="@id/icPlano" app:layout_constraintStart_toEndOf="@id/icPlano" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Divisor  -->
                    <View android:id="@+id/dividerPlano" android:layout_width="0dp" android:layout_height="0.5dp" android:background="@color/divider_gray" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" app:layout_constraintTop_toBottomOf="@id/icPlano" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Data de membro  -->
                    <ImageView android:id="@+id/icData" android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_today" android:contentDescription="Data de cadastro" app:layout_constraintTop_toBottomOf="@id/dividerPlano" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtDataCadastroPerfil" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Membro desde: Jan 2025" android:textSize="13sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/icData" app:layout_constraintBottom_toBottomOf="@id/icData" app:layout_constraintStart_toEndOf="@id/icData" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Botão SAIR DA CONTA  -->
            <Button android:id="@+id/btnSairConta" android:layout_width="0dp" android:layout_height="48dp" android:text="SAIR DA CONTA" android:textColor="@color/white" android:backgroundTint="@color/danger_red" android:textSize="14sp" android:letterSpacing="0.05" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" app:layout_constraintTop_toBottomOf="@id/cardDadosPerfil" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>