<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray">
    <!--  Banner azul superior  -->
    <View android:id="@+id/viewBannerLogin" android:layout_width="0dp" android:layout_height="250dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Logo centralizada no banner  -->
    <ImageView android:id="@+id/imgLogoLogin" android:layout_width="160dp" android:layout_height="60dp" android:scaleType="fitCenter" android:src="@drawable/logo_maya" android:contentDescription="Logo Maya" app:layout_constraintTop_toTopOf="@id/viewBannerLogin" app:layout_constraintBottom_toBottomOf="@id/viewBannerLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVerticalBias="0.4"/>
    <!--  CardView principal flutuando sobre o banner  -->
    <androidx.cardview.widget.CardView android:id="@+id/cardLogin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="6dp" app:layout_constraintTop_toBottomOf="@id/viewBannerLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVerticalBias="0.0" android:layout_marginTop="-48dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
            <!--  Abas LOGIN / CRIAR CONTA  -->
            <LinearLayout android:id="@+id/layoutAbasLogin" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/tabLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOGIN" android:textSize="13sp" android:textColor="@color/maya_cyan" android:paddingBottom="4dp" android:layout_marginEnd="16dp"/>
                <TextView android:id="@+id/tabCriarConta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRIAR CONTA" android:textSize="13sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
            <!--  Campo E-mail  -->
            <EditText android:id="@+id/editEmail" android:layout_width="0dp" android:layout_height="48dp" android:hint="Usuário" android:inputType="textEmailAddress" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/layoutAbasLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="12dp"/>
            <!--  Campo Senha  -->
            <EditText android:id="@+id/editSenha" android:layout_width="0dp" android:layout_height="48dp" android:hint="Senha" android:inputType="textPassword" android:background="@drawable/bg_input_rounded" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/editEmail" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="16dp"/>
            <!--  Botão LOGIN  -->
            <Button android:id="@+id/btnLogin" android:layout_width="0dp" android:layout_height="48dp" android:text="LOGIN" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="15sp" android:letterSpacing="0.08" app:layout_constraintTop_toBottomOf="@id/editSenha" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
            <!--  Link Esqueceu a senha  -->
            <TextView android:id="@+id/txtEsqueceuSenha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esqueceu a senha?" android:textSize="12sp" android:textColor="@color/maya_cyan" app:layout_constraintTop_toBottomOf="@id/btnLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="16dp"/>
            <!--  Divisor social  -->
            <TextView android:id="@+id/txtEntrarCom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrar com" android:textSize="11sp" android:textColor="@color/text_muted" app:layout_constraintTop_toBottomOf="@id/txtEsqueceuSenha" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="10dp"/>
            <!--  Botões sociais  -->
            <LinearLayout android:id="@+id/layoutBotoesSociais" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/txtEntrarCom" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="8dp">
                <ImageButton android:id="@+id/btnLoginApple" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@drawable/bg_social_button" android:scaleType="centerInside" android:contentDescription="Login com Apple" android:layout_marginEnd="16dp"/>
                <ImageButton android:id="@+id/btnLoginGoogle" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_search" android:background="@drawable/bg_social_button" android:scaleType="centerInside" android:contentDescription="Login com Google"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <!--  Botão ir para Cadastro  -->
    <Button android:id="@+id/btnIrParaCadastro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Não tem conta? Cadastre-se" android:textColor="@color/maya_cyan" android:background="@android:color/transparent" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/cardLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>