<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray">
    <!--  Banner azul superior  -->
    <View android:id="@+id/viewBannerExercicio" android:layout_width="0dp" android:layout_height="56dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/txtTituloExerciciosGeral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROTINA DE HOJE" android:textSize="16sp" android:textColor="@color/white" android:textStyle="bold" android:letterSpacing="0.08" app:layout_constraintTop_toTopOf="@id/viewBannerExercicio" app:layout_constraintBottom_toBottomOf="@id/viewBannerExercicio" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  ScrollView da lista de exercícios  -->
    <ScrollView android:id="@+id/scrollExercicios" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="72dp" app:layout_constraintTop_toBottomOf="@id/viewBannerExercicio" app:layout_constraintBottom_toTopOf="@id/btnSalvarRotina" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
            <!--  Card Exercício 1  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardExercicioCompleto1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <ImageView android:id="@+id/imgExercicioItem" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Imagem do exercício" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtTituloExercicioItem" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Alongamento Cervical" android:textSize="14sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/imgExercicioItem" app:layout_constraintStart_toEndOf="@id/imgExercicioItem" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtDetalhesExercicioItem" android:layout_width="0dp" android:layout_height="wrap_content" android:text="2 séries de 15 segundos" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtTituloExercicioItem" app:layout_constraintStart_toEndOf="@id/imgExercicioItem" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnAvaliarExercicio" android:layout_width="0dp" android:layout_height="36dp" android:text="AVALIAR" android:textColor="@color/text_dark" android:backgroundTint="@color/divider_gray" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnIniciarExercicio"/>
                    <Button android:id="@+id/btnIniciarExercicio" android:layout_width="0dp" android:layout_height="36dp" android:text="INICIAR" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginStart="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem" app:layout_constraintStart_toEndOf="@id/btnAvaliarExercicio" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Card Exercício 2  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardExercicioCompleto2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/cardExercicioCompleto1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <ImageView android:id="@+id/imgExercicioItem2" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Imagem do exercício" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtTituloExercicioItem2" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Cocóras Guiadas" android:textSize="14sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/imgExercicioItem2" app:layout_constraintStart_toEndOf="@id/imgExercicioItem2" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtDetalhesExercicioItem2" android:layout_width="0dp" android:layout_height="wrap_content" android:text="3 séries de 10 repetições" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtTituloExercicioItem2" app:layout_constraintStart_toEndOf="@id/imgExercicioItem2" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnAvaliarExercicio2" android:layout_width="0dp" android:layout_height="36dp" android:text="AVALIAR" android:textColor="@color/text_dark" android:backgroundTint="@color/divider_gray" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnIniciarExercicio2"/>
                    <Button android:id="@+id/btnIniciarExercicio2" android:layout_width="0dp" android:layout_height="36dp" android:text="INICIAR" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginStart="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem2" app:layout_constraintStart_toEndOf="@id/btnAvaliarExercicio2" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Card Exercício 3  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardExercicioCompleto3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/cardExercicioCompleto2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <ImageView android:id="@+id/imgExercicioItem3" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Imagem do exercício" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/txtTituloExercicioItem3" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Mobilidade Quadril" android:textSize="14sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="@id/imgExercicioItem3" app:layout_constraintStart_toEndOf="@id/imgExercicioItem3" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtDetalhesExercicioItem3" android:layout_width="0dp" android:layout_height="wrap_content" android:text="2 séries de 12 repetições" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtTituloExercicioItem3" app:layout_constraintStart_toEndOf="@id/imgExercicioItem3" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnAvaliarExercicio3" android:layout_width="0dp" android:layout_height="36dp" android:text="AVALIAR" android:textColor="@color/text_dark" android:backgroundTint="@color/divider_gray" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnIniciarExercicio3"/>
                    <Button android:id="@+id/btnIniciarExercicio3" android:layout_width="0dp" android:layout_height="36dp" android:text="INICIAR" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="11sp" android:layout_marginTop="10dp" android:layout_marginStart="6dp" app:layout_constraintTop_toBottomOf="@id/imgExercicioItem3" app:layout_constraintStart_toEndOf="@id/btnAvaliarExercicio3" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <!--  Botão SALVAR ROTINA fixado na base  -->
    <Button android:id="@+id/btnSalvarRotina" android:layout_width="0dp" android:layout_height="48dp" android:text="SALVAR ROTINA" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan_dark" android:textSize="14sp" android:letterSpacing="0.05" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>