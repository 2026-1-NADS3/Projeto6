<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray">
    <!--  Cabeçalho fixo azul  -->
    <View android:id="@+id/viewCabecalhoProgresso" android:layout_width="0dp" android:layout_height="56dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/txtTituloProgresso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEU PROGRESSO" android:textSize="16sp" android:textColor="@color/white" android:textStyle="bold" android:letterSpacing="0.08" app:layout_constraintTop_toTopOf="@id/viewCabecalhoProgresso" app:layout_constraintBottom_toBottomOf="@id/viewCabecalhoProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  ScrollView do conteúdo  -->
    <ScrollView android:id="@+id/scrollProgresso" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" app:layout_constraintTop_toBottomOf="@id/viewCabecalhoProgresso" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
            <!--  Título Visão Geral  -->
            <TextView android:id="@+id/txtVisaoGeral" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Visão Geral" android:textSize="14sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <!--  Linha superior: Meta + Sequência  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardMetaProgresso" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginEnd="8dp" app:cardBackgroundColor="@color/maya_cyan" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtVisaoGeral" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/cardSequencia" app:layout_constraintWidth_percent="0.45" app:layout_constraintDimensionRatio="1:1">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp">
                    <ImageView android:id="@+id/icMetaProgresso" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="Ícone progresso" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtPorcentagemMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40%" android:textSize="28sp" android:textColor="@color/white" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/icMetaProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnContinuarMeta" android:layout_width="0dp" android:layout_height="28dp" android:text="CONTINUAR" android:textColor="@color/maya_cyan" android:backgroundTint="@color/white" android:textSize="9sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Card Sequência de dias  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardSequencia" android:layout_width="0dp" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtVisaoGeral" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/cardMetaProgresso">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
                    <TextView android:id="@+id/txtLabelSequencia" android:layout_width="0dp" android:layout_height="wrap_content" android:text="SEQUÊNCIA DE DIAS" android:textSize="9sp" android:textColor="@color/text_dark" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Dias da semana (representados por TextViews)  -->
                    <LinearLayout android:id="@+id/layoutDias" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" app:layout_constraintTop_toBottomOf="@id/txtLabelSequencia" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:text="S" android:textSize="9sp" android:textColor="@color/white" android:background="@color/maya_cyan" android:gravity="center" android:layout_marginEnd="2dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:text="T" android:textSize="9sp" android:textColor="@color/white" android:background="@color/maya_cyan" android:gravity="center" android:layout_marginEnd="2dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:text="Q" android:textSize="9sp" android:textColor="@color/white" android:background="@color/maya_cyan" android:gravity="center" android:layout_marginEnd="2dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:text="Q" android:textSize="9sp" android:textColor="@color/maya_cyan" android:background="@drawable/bg_dia_vazio" android:gravity="center" android:layout_marginEnd="2dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:text="S" android:textSize="9sp" android:textColor="@color/divider_gray" android:background="@drawable/bg_dia_vazio" android:gravity="center"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Seção Conquistas  -->
            <TextView android:id="@+id/txtSecaoConquistas" android:layout_width="0dp" android:layout_height="wrap_content" android:text="CONQUISTAS" android:textSize="11sp" android:textColor="@color/maya_cyan" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" app:layout_constraintTop_toBottomOf="@id/cardMetaProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardConquistas" android:layout_width="0dp" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtSecaoConquistas" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <LinearLayout android:id="@+id/layoutMedalhas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/star_big_on" android:contentDescription="Medalha 1" android:layout_marginEnd="8dp"/>
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/star_big_on" android:contentDescription="Medalha 2" android:layout_marginEnd="8dp"/>
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/star_big_off" android:contentDescription="Medalha 3"/>
                    </LinearLayout>
                    <TextView android:id="@+id/txtVerMais" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VER MAIS" android:textSize="10sp" android:textColor="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Seção Sua Jornada  -->
            <TextView android:id="@+id/txtSecaoJornada" android:layout_width="0dp" android:layout_height="wrap_content" android:text="SUA JORNADA" android:textSize="11sp" android:textColor="@color/maya_cyan" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" app:layout_constraintTop_toBottomOf="@id/cardConquistas" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardGraficoProgresso" android:layout_width="0dp" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtSecaoJornada" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <TextView android:id="@+id/txtDataProgresso" android:layout_width="0dp" android:layout_height="wrap_content" android:text="domingo, 14 Março" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginBottom="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <!--  Área do gráfico (placeholder para renderização dinâmica)  -->
                    <View android:id="@+id/viewGrafico" android:layout_width="0dp" android:layout_height="120dp" android:background="@color/background_gray" app:layout_constraintTop_toBottomOf="@id/txtDataProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtDrMaya" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. Maya" android:textSize="10sp" android:textColor="@color/text_muted" android:layout_marginTop="6dp" app:layout_constraintTop_toBottomOf="@id/viewGrafico" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Card Exercício histórico  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardExercicioItem1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/cardGraficoProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <ImageView android:id="@+id/imgExercicioHistorico" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Exercício" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView android:id="@+id/txtTituloExercicioHistorico" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Alongamento Cervical" android:textSize="13sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/imgExercicioHistorico" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtDetalhesExercicioHistorico" android:layout_width="0dp" android:layout_height="wrap_content" android:text="2 séries de 15 segundos — Concluído" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtTituloExercicioHistorico" app:layout_constraintStart_toEndOf="@id/imgExercicioHistorico" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>