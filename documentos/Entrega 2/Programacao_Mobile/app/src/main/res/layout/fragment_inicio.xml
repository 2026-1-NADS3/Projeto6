<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_gray">
    <!--  Banner superior discreto  -->
    <View android:id="@+id/viewBannerInicio" android:layout_width="0dp" android:layout_height="80dp" android:background="@color/maya_cyan" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView android:id="@+id/imgLogoInicio" android:layout_width="100dp" android:layout_height="36dp" android:scaleType="fitCenter" android:src="@drawable/logo_maya" android:contentDescription="Logo Maya" app:layout_constraintTop_toTopOf="@id/viewBannerInicio" app:layout_constraintBottom_toBottomOf="@id/viewBannerInicio" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  ScrollView do conteúdo principal  -->
    <ScrollView android:id="@+id/scrollInicio" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" app:layout_constraintTop_toBottomOf="@id/viewBannerInicio" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
            <!--  Card médico / próxima consulta  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardMedico" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <ImageView android:id="@+id/imgAvatarMedico" android:layout_width="42dp" android:layout_height="42dp" android:src="@android:drawable/ic_menu_myplaces" android:contentDescription="Avatar médico" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="@id/txtNomeMedico"/>
                    <TextView android:id="@+id/txtNomeMedico" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Dr Maya Yamamoto" android:textSize="14sp" android:textColor="@color/text_dark" android:textStyle="bold" android:layout_marginStart="10dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/imgAvatarMedico" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtInfoConsulta" android:layout_width="0dp" android:layout_height="wrap_content" android:text="17/03, 13:30h, Clínica Liberdade" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginStart="10dp" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtNomeMedico" app:layout_constraintStart_toEndOf="@id/imgAvatarMedico" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnGerenciarConsulta" android:layout_width="0dp" android:layout_height="36dp" android:text="GERENCIAR" android:textColor="@color/white" android:backgroundTint="@color/maya_cyan" android:textSize="12sp" android:layout_marginTop="10dp" app:layout_constraintTop_toBottomOf="@id/txtInfoConsulta" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Título seção PROGRESSO  -->
            <TextView android:id="@+id/txtSecaoProgresso" android:layout_width="0dp" android:layout_height="wrap_content" android:text="PROGRESSO" android:textSize="11sp" android:textColor="@color/maya_cyan" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" app:layout_constraintTop_toBottomOf="@id/cardMedico" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <!--  Card Progresso  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardProgressoInicio" android:layout_width="0dp" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/txtSecaoProgresso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <TextView android:id="@+id/txtMetaSemanal" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Meta Semanal" android:textSize="13sp" android:textColor="@color/text_dark" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView android:id="@+id/txtExerciciosConcluidos" android:layout_width="0dp" android:layout_height="wrap_content" android:text="4/10 exercícios" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/txtMetaSemanal" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    <Button android:id="@+id/btnContinuarProgresso" android:layout_width="wrap_content" android:layout_height="32dp" android:text="CONTINUAR" android:textColor="@color/maya_cyan" android:backgroundTint="@color/white" android:textSize="11sp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/txtExerciciosConcluidos" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  Atalhos rápidos  -->
            <LinearLayout android:id="@+id/layoutAtalhos" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp" app:layout_constraintTop_toBottomOf="@id/cardProgressoInicio" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <androidx.cardview.widget.CardView android:id="@+id/btnCardAgendamento" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
                        <ImageView android:id="@+id/icAgendamento" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_today" android:contentDescription="Agendamento" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        <TextView android:id="@+id/txtAgendamento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agendamento" android:textSize="10sp" android:textColor="@color/text_dark" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/icAgendamento" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/btnCardProntuario" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
                        <ImageView android:id="@+id/icProntuario" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="Prontuário" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        <TextView android:id="@+id/txtProntuario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prontuário" android:textSize="10sp" android:textColor="@color/text_dark" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/icProntuario" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/btnCardContato" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
                        <ImageView android:id="@+id/icContato" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_call" android:contentDescription="Contato" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        <TextView android:id="@+id/txtContato" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contato" android:textSize="10sp" android:textColor="@color/text_dark" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/icContato" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <!--  Título FIQUE POR DENTRO  -->
            <TextView android:id="@+id/txtFiquePorDentro" android:layout_width="0dp" android:layout_height="wrap_content" android:text="FIQUE POR DENTRO" android:textSize="11sp" android:textColor="@color/maya_cyan" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" app:layout_constraintTop_toBottomOf="@id/layoutAtalhos" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
            <!--  Carrossel horizontal de exercícios em destaque  -->
            <HorizontalScrollView android:id="@+id/scrollDestaque" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:layout_constraintTop_toBottomOf="@id/txtFiquePorDentro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.cardview.widget.CardView android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="8dp" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <ImageView android:layout_width="0dp" android:layout_height="0dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Exercício destaque" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/txtDestaqueItem1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                            <TextView android:id="@+id/txtDestaqueItem1" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Alongamento" android:textSize="10sp" android:textColor="@color/text_dark" android:padding="6dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="8dp" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <ImageView android:layout_width="0dp" android:layout_height="0dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Exercício destaque" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/txtDestaqueItem2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                            <TextView android:id="@+id/txtDestaqueItem2" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Cocóras" android:textSize="10sp" android:textColor="@color/text_dark" android:padding="6dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>